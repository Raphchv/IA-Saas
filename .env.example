# Copie ce fichier en `.env` puis remplis les valeurs.
# Ne commite JAMAIS le fichier `.env` (il est ignoré par git).

# Base de données (correspond à docker-compose.yml)
DATABASE_URL="postgresql://aitoolbox:aitoolbox@localhost:5432/aitoolbox"

# Authentification : secret aléatoire d'au moins 32 caractères.
# Génère-le avec : openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL publique de l'application
BETTER_AUTH_URL="http://localhost:3000"

# OpenAI : https://platform.openai.com/api-keys
# Sans clé, l'import et la recherche par mots-clés fonctionnent,
# mais pas la recherche par le sens ni "Ask my history".
OPENAI_API_KEY=""
# Modèles utilisés (optionnel)
OPENAI_CHAT_MODEL="gpt-5.4-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Taille maximale d'un export ZIP, en Mo (optionnel)
MAX_UPLOAD_MB="500"
